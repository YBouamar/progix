# Réglages de production de PROGIX. Copier ce fichier en « .env » à la racine du projet, sur le serveur, puis le remplir.
# Ce fichier contient des secrets : ne le partagez pas et ne le mettez pas dans un dépôt de code.

# Adresse du site. Avec un nom de domaine : le domaine seul, et PUBLIC_URL en https.
SITE_ADDRESS=progix.votre-domaine.ma
PUBLIC_URL=https://progix.votre-domaine.ma
# Sans nom de domaine (accès par l'adresse IP, sans HTTPS, déconseillé) :
# SITE_ADDRESS=:80
# PUBLIC_URL=http://ADRESSE_IP_DU_SERVEUR

# Secrets : générez chacun avec la commande « openssl rand -hex 32 ».
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
JWT_KEY=

MINIO_ROOT_USER=progix

# Premier compte directeur, créé au premier démarrage. Identifiant de connexion : directeur.
# Mot de passe : 8 caractères au moins, avec majuscule, minuscule, chiffre et symbole.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Courriels aux directeurs : réception de dalle, mise en tension, injection, nouveau paiement.
# Laisser SMTP_HOST vide pour ne rien envoyer. Les adresses des destinataires sont celles des comptes « Directeur ».
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PROGIX <progix@votre-domaine.ma>
# starttls (port 587), ssl (port 465) ou aucun
SMTP_SECURITE=starttls
