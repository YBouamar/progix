# Copier ce fichier en .env pour changer les valeurs par défaut.
POSTGRES_PASSWORD=progix
JWT_KEY=cle-de-developpement-a-remplacer-en-production-0123456789
ADMIN_EMAIL=directeur@progix.local
ADMIN_PASSWORD=Progix#2026
MINIO_ROOT_USER=progix
MINIO_ROOT_PASSWORD=progix-minio

# Adresse publique de PROGIX : le QR code des reçus de paiement y renvoie pour vérifier un document.
PUBLIC_URL=http://localhost:3000

# Courriels aux directeurs : réception de dalle, mise en tension, injection, nouveau paiement.
# Laisser SMTP_HOST vide pour ne rien envoyer. Les adresses des destinataires sont celles des comptes « Directeur ».
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PROGIX <progix@votre-domaine.ma>
# starttls (port 587), ssl (port 465) ou aucun
SMTP_SECURITE=starttls
