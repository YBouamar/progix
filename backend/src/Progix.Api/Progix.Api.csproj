<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Modules\Progix.Modules.Identity\Progix.Modules.Identity.csproj" />
    <ProjectReference Include="..\Modules\Progix.Modules.Partenaires\Progix.Modules.Partenaires.csproj" />
    <ProjectReference Include="..\Progix.SharedKernel\Progix.SharedKernel.csproj" />
    <ProjectReference Include="..\Modules\Progix.Modules.Projets\Progix.Modules.Projets.csproj" />
    <ProjectReference Include="..\Modules\Progix.Modules.Devis\Progix.Modules.Devis.csproj" />
    <ProjectReference Include="..\Modules\Progix.Modules.Fichiers\Progix.Modules.Fichiers.csproj" />
    <ProjectReference Include="..\Modules\Progix.Modules.Facturation\Progix.Modules.Facturation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.17" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.20.10" />
    <PackageReference Include="MailKit" Version="4.18.1" />
